# ---------------------------------------------------------------------
# KaziWise web client
# ---------------------------------------------------------------------
# Copy to .env.local and adjust. Only variables prefixed with VITE_ are
# exposed to the browser bundle, so never put a secret in here.
#
# In `npm run dev` the Vite proxy forwards /v1 to the Go API, so you can
# leave this empty and everything stays on one origin.
# ---------------------------------------------------------------------

# Base URL of the KaziWise Go API. Leave empty to use the dev proxy.
# In production this is the public API origin, e.g. https://api.kaziwise.com
VITE_API_URL=

# Origin the dev server proxies to.
VITE_API_PROXY=http://localhost:8080

# Show the "Demo Mode" chip in the header when the organisation is seeded
# demo data. Matches the prototype header requirement.
VITE_SHOW_DEMO_BADGE=true
